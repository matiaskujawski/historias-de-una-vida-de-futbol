# Copiá este archivo a ".env" y completá lo que tengas.
# Sin ninguna de estas dos claves, el sitio funciona igual en "modo
# placeholder": genera un guion simple con reglas fijas y páginas de
# ejemplo con color de club + texto, para poder probar todo el flujo
# de punta a punta sin gastar un solo request real.

PORT=3000

# Guion del libro (Autor IA). Sin esta clave, se usa un generador de
# guion local muy simple (server/lib/claudeClient.js -> modo placeholder).
ANTHROPIC_API_KEY=

# Solo hace falta si tu ANTHROPIC_API_KEY NO está scopeada a un workspace
# (la API devuelve un error 400 pidiendo este header). Se soluciona de raíz
# creando la key desde ADENTRO de un workspace en console.anthropic.com en
# vez de la vista general de "API Keys" — con eso no hace falta esta
# variable. Si igual la necesitás, el ID del workspace aparece en la URL
# cuando estás parado en ese workspace en la consola.
ANTHROPIC_WORKSPACE_ID=

# Imágenes de tapa y páginas (estilo caricatura). Sin esta clave, se usan
# imágenes placeholder en SVG puro (server/lib/imageProvider.js +
# server/lib/svgPlaceholder.js -> modo placeholder, sin dependencias).
FAL_KEY=
