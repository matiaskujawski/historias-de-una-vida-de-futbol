# Copiá este archivo a ".env" y completá lo que tengas.
# Sin ninguna de estas dos claves, el sitio funciona igual en "modo
# placeholder": genera un guion simple con reglas fijas y páginas de
# ejemplo con color de club + texto, para poder probar todo el flujo
# de punta a punta sin gastar un solo request real.

PORT=3000

# Guion del libro (Autor IA). Sin esta clave, se usa un generador de
# guion local muy simple (server/lib/claudeClient.js -> modo placeholder).
ANTHROPIC_API_KEY=

# Imágenes de tapa y páginas (estilo caricatura). Sin esta clave, se
# usan imágenes placeholder generadas con Pillow (server/lib/imageProvider.js
# -> modo placeholder, ver scripts/generate_placeholder_image.py).
FAL_KEY=
